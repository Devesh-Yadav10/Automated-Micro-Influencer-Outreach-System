# ==============================================================================
# Micro-Influencer Outreach System - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# SQLite Database Location
DATABASE_PATH=data/micro_influencer.db

# Outreach Mode: 'simulation' (default, safe) or 'live_smtp'
# In simulation mode, no actual emails are dispatched; logs are recorded to SQLite.
OUTREACH_MODE=simulation

# External Discovery API Keys (Optional for seed mode; required for live YouTube API)
YOUTUBE_API_KEY=

# LLM Personalization Credentials (Optional; fallback template engine used if missing)
# Supported options: 'gemini', 'openai', 'fallback'
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMTP Credentials (Only used when OUTREACH_MODE=live_smtp; kept blank for simulation)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=outreach@example.com

